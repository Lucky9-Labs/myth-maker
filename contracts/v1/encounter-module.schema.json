{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/encounter-module.schema.json",
  "title": "EncounterModule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_id", "revision", "execution_kind", "provides", "requires", "conflicts", "compatibility", "quality", "fallback_module_ids"],
  "properties": {
    "schema_version": { "const": "1" },
    "module_id": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "execution_kind": { "enum": ["recipe", "runtime_asset", "managed_plugin", "remote_logic"] },
    "provides": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/semanticTag" }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/contractName" }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/semanticTag" }
    },
    "compatibility": { "$ref": "common.schema.json#/$defs/compatibility" },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "score"],
      "properties": {
        "tier": { "type": "integer", "minimum": 0, "maximum": 4 },
        "score": { "type": "number", "minimum": 0 },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 512 } }
      }
    },
    "artifact": { "$ref": "common.schema.json#/$defs/artifactReference" },
    "entrypoint": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inline_recipe": { "type": "object", "additionalProperties": true },
    "fallback_module_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "created_at"],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "parent_module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "label": { "type": "string", "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "execution_kind": { "const": "recipe" } } },
      "then": { "required": ["inline_recipe"] },
      "else": { "required": ["artifact"] }
    },
    {
      "if": { "properties": { "execution_kind": { "const": "managed_plugin" } } },
      "then": { "required": ["entrypoint"] }
    }
  ]
}
