{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/package-discovery-manifest.schema.json",
  "title": "PackageDiscoveryManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "encounter_id", "request_id", "package_id", "package_revision", "package_manifest_sha256", "assembly_receipt_id", "assembly_receipt_sha256", "catalog_revision_id", "catalog_revision_sha256", "artifacts", "issued_at", "signature"],
  "properties": {
    "schema_version": { "const": "1" },
    "manifest_id": { "$ref": "common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "common.schema.json#/$defs/id" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "package_id": { "$ref": "common.schema.json#/$defs/id" },
    "package_revision": { "type": "integer", "minimum": 1 },
    "package_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "assembly_receipt_id": { "$ref": "common.schema.json#/$defs/id" },
    "assembly_receipt_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "catalog_revision_id": { "$ref": "common.schema.json#/$defs/id" },
    "catalog_revision_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "revision", "uri", "sha256", "media_type"],
      "properties": {
        "module_id": { "$ref": "common.schema.json#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "media_type": { "const": "model/gltf-binary" },
        "byte_length": { "type": "integer", "minimum": 0 }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "const": "package-discovery-ed25519-v1" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
