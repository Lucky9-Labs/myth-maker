{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/asset-production-run.schema.json",
  "title": "AssetProductionRun",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "project_id", "asset_set_id", "source_revision", "runtime_deployment", "status", "started_at", "jobs", "defects", "acceptance", "measurement"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "$ref": "#/$defs/id" },
    "project_id": { "$ref": "#/$defs/id" },
    "asset_set_id": { "$ref": "#/$defs/id" },
    "source_revision": { "$ref": "#/$defs/sha256" },
    "parent_revision": { "$ref": "#/$defs/sha256" },
    "runtime_deployment": { "$ref": "#/$defs/runtimeDeployment" },
    "status": { "enum": ["ingesting", "running", "awaiting_visual_acceptance", "accepted", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/jobReceipt" } },
    "defects": { "type": "array", "items": { "$ref": "#/$defs/defect" } },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "measurement": { "$ref": "#/$defs/runMeasurement" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtimeDeployment": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "source_sha", "function_id", "volume", "lease_store", "max_containers"],
      "properties": {
        "provider": { "const": "modal" },
        "source_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "function_id": { "type": "string", "pattern": "^fu-[A-Za-z0-9]+$" },
        "volume": { "type": "string", "minLength": 1 },
        "lease_store": { "type": "string", "minLength": 1 },
        "max_containers": { "const": 4 }
      }
    },
    "measurementValue": {
      "type": "object", "additionalProperties": false,
      "required": ["provenance", "value"],
      "properties": {
        "provenance": { "enum": ["measured", "estimated", "unavailable"] },
        "value": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "jobReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["work_id", "attempt", "worker_slot", "job_type", "status", "input_hashes", "output_hashes", "queue_ms", "execution_ms", "model_usage", "human_minutes"],
      "properties": {
        "work_id": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1 },
        "worker_slot": { "enum": ["worker-a", "worker-b", "worker-c", "worker-d"] },
        "job_type": { "enum": ["mech-structure", "mech-armor", "railgun", "kit-assembly", "final-validation", "visual-critique"] },
        "status": { "enum": ["completed", "failed", "discarded"] },
        "input_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "output_hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "queue_ms": { "$ref": "#/$defs/measurementValue" },
        "execution_ms": { "$ref": "#/$defs/measurementValue" },
        "model_usage": {
          "type": "object", "additionalProperties": false,
          "required": ["provenance", "input_tokens", "cached_input_tokens", "output_tokens"],
          "properties": {
            "provenance": { "enum": ["measured", "unavailable"] },
            "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "cached_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "output_tokens": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "human_minutes": { "$ref": "#/$defs/measurementValue" }
      }
    },
    "defect": {
      "type": "object", "additionalProperties": false,
      "required": ["defect_id", "component_id", "evidence_view", "observable_problem", "severity", "criterion", "recommended_correction", "confidence", "disposition"],
      "properties": {
        "defect_id": { "$ref": "#/$defs/id" },
        "component_id": { "$ref": "#/$defs/id" },
        "evidence_view": { "type": "string", "minLength": 1 },
        "observable_problem": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "severity": { "enum": ["blocking", "nonblocking", "cosmetic"] },
        "criterion": { "enum": ["silhouette", "reference-coherence", "fit", "articulation", "weapon-handling", "animation-readability", "material-identity", "export", "performance"] },
        "recommended_correction": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "disposition": { "enum": ["accepted", "resolved", "rejected", "backlog"] }
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["assembly", "rig", "animation", "export", "performance", "unity_runtime", "visual_review"],
      "properties": {
        "assembly": { "enum": ["pending", "passed", "failed"] },
        "rig": { "enum": ["pending", "passed", "failed"] },
        "animation": { "enum": ["pending", "passed", "failed"] },
        "export": { "enum": ["pending", "passed", "failed"] },
        "performance": { "enum": ["pending", "passed", "failed"] },
        "unity_runtime": { "enum": ["pending", "passed", "failed"] },
        "visual_review": { "enum": ["pending", "accepted", "rejected"] }
      }
    },
    "runMeasurement": {
      "type": "object", "additionalProperties": false,
      "required": ["elapsed_ms", "compute_ms", "human_minutes", "input_tokens", "cached_input_tokens", "output_tokens", "core_kit_ms", "asset_specific_ms"],
      "properties": {
        "elapsed_ms": { "$ref": "#/$defs/measurementValue" },
        "compute_ms": { "$ref": "#/$defs/measurementValue" },
        "human_minutes": { "$ref": "#/$defs/measurementValue" },
        "input_tokens": { "$ref": "#/$defs/measurementValue" },
        "cached_input_tokens": { "$ref": "#/$defs/measurementValue" },
        "output_tokens": { "$ref": "#/$defs/measurementValue" },
        "core_kit_ms": { "$ref": "#/$defs/measurementValue" },
        "asset_specific_ms": { "$ref": "#/$defs/measurementValue" }
      }
    }
  }
}
