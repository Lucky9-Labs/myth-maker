{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/playable-encounter-package.schema.json",
  "title": "PlayableEncounterPackage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "encounter_id", "revision", "state", "assembled_at", "module_ids", "manifest_sha256", "fallback_provenance"],
  "properties": {
    "schema_version": { "const": "1" },
    "package_id": { "$ref": "common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["candidate", "preloading", "ready", "frozen", "rejected"] },
    "assembled_at": { "type": "string", "format": "date-time" },
    "frozen_at": { "type": "string", "format": "date-time" },
    "module_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/id" }
    },
    "manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "fallback_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_fallback", "module_ids"],
      "properties": {
        "used_fallback": { "type": "boolean" },
        "module_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        }
      }
    },
    "rejection_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "frozen" } } },
      "then": { "required": ["frozen_at"] }
    }
  ]
}
