{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/unity-host-handoff-manifest.schema.json",
  "title": "UnityHostHandoffManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "assembly_receipt", "load_deadline_ms", "evidence", "concept_lineage", "handoff_sha256"],
  "properties": {
    "schema_version": { "const": "1" },
    "handoff_id": { "$ref": "common.schema.json#/$defs/id" },
    "assembly_receipt": { "$ref": "assembly-receipt.schema.json" },
    "load_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "evidence": { "$ref": "#/$defs/evidence" },
    "concept_lineage": { "$ref": "#/$defs/lineage" },
    "handoff_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "evidence": { "type": "object", "additionalProperties": false, "required": ["source", "host_load", "player_facing"], "properties": { "source": { "const": "local_blender_cli_observed" }, "host_load": { "const": "not_observed" }, "player_facing": { "const": "not_observed" } } },
    "revisionReference": { "type": "object", "additionalProperties": false, "required": ["id", "revision", "content_sha256"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" } } },
    "notRecorded": { "type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": { "kind": { "const": "not_recorded" }, "reason": { "const": "pre_gate_bootstrap" } } },
    "bootstrapWaiver": { "type": "object", "additionalProperties": false, "required": ["kind", "waiver"], "properties": { "kind": { "const": "reuse_maintenance_waiver" }, "waiver": { "type": "object", "additionalProperties": false, "required": ["kind", "bounded_reason", "approver", "approved_at", "expires_at", "asset_ids"], "properties": { "kind": { "enum": ["reuse", "maintenance"] }, "bounded_reason": { "type": "string", "minLength": 1, "maxLength": 512 }, "approver": { "$ref": "common.schema.json#/$defs/id" }, "approved_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" }, "asset_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } } } } } },
    "conceptLineage": { "type": "object", "additionalProperties": false, "required": ["kind", "encounter_intent", "art_direction_revision", "concept_reference_revision"], "properties": { "kind": { "const": "concept_lineage" }, "encounter_intent": { "$ref": "#/$defs/revisionReference" }, "art_direction_revision": { "$ref": "#/$defs/revisionReference" }, "concept_reference_revision": { "$ref": "#/$defs/revisionReference" } } },
    "lineage": { "oneOf": [{ "$ref": "#/$defs/notRecorded" }, { "$ref": "#/$defs/bootstrapWaiver" }, { "$ref": "#/$defs/conceptLineage" }] }
  }
}
