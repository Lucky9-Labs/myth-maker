{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/simulation-receipt.schema.json",
  "title": "SimulationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "simulation_id", "encounter_id", "assembly_sha256", "package_manifest_sha256", "runner", "evidence_tiers", "deterministic", "status", "telemetry", "timings", "logs", "failure_codes", "provenance"],
  "properties": {
    "schema_version": { "const": "1" },
    "simulation_id": { "$ref": "common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "common.schema.json#/$defs/id" },
    "assembly_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "package_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "runner": { "type": "object", "additionalProperties": false, "required": ["runner_id", "runtime_id", "build_profile_id", "profile_id", "profile_revision"], "properties": { "runner_id": { "$ref": "common.schema.json#/$defs/id" }, "runtime_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "build_profile_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "profile_id": { "$ref": "common.schema.json#/$defs/id" }, "profile_revision": { "type": "integer", "minimum": 1 } } },
    "evidence_tiers": { "type": "object", "additionalProperties": false, "required": ["source", "runtime", "player"], "properties": { "source": { "enum": ["local_orchestration", "not_observed"] }, "runtime": { "enum": ["local_unity_runner", "cloud_headless_validation", "cloud_rendered_preview", "not_observed"] }, "player": { "enum": ["local_unity_runner", "cloud_rendered_preview", "not_observed"] } } },
    "deterministic": { "type": "object", "additionalProperties": false, "required": ["seed", "script_sha256", "event_count"], "properties": { "seed": { "type": "integer", "minimum": 0 }, "script_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "event_count": { "type": "integer", "minimum": 1 } } },
    "status": { "enum": ["passed", "failed"] },
    "telemetry": { "type": "object", "additionalProperties": false, "required": ["hit_exchange", "passed_checks", "failed_checks"], "properties": { "hit_exchange": { "type": "object", "additionalProperties": false, "required": ["verified", "events"], "properties": { "verified": { "type": "boolean" }, "events": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["at_ms", "actor", "target", "damage"], "properties": { "at_ms": { "type": "integer", "minimum": 0 }, "actor": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 }, "damage": { "type": "number", "exclusiveMinimum": 0 } } } } } }, "passed_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "failed_checks": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "timings": { "type": "object", "additionalProperties": false, "required": ["started_at", "ended_at", "duration_ms"], "properties": { "started_at": { "type": "string", "format": "date-time" }, "ended_at": { "type": "string", "format": "date-time" }, "duration_ms": { "type": "integer", "minimum": 0 } } },
    "logs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 2048 }, "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" } } } },
    "failure_codes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/semanticTag" } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["assembly_id", "selected_assets", "selected_animations"], "properties": { "assembly_id": { "$ref": "common.schema.json#/$defs/id" }, "selected_assets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["asset_id", "revision", "sha256"], "properties": { "asset_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" } } } }, "selected_animations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["animation_id", "revision", "sha256"], "properties": { "animation_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" } } } } } },
    "frame_or_clip_artifact": { "$ref": "common.schema.json#/$defs/artifactReference" }
  }
}
