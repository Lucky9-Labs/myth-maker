{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v1/assembly-receipt.schema.json",
  "title": "AssemblyReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assembly_id", "encounter_id", "frozen_package", "package_manifest_sha256", "selected_assets", "selected_animations", "assembled_at", "source_evidence", "assembly_sha256"],
  "properties": {
    "schema_version": { "const": "1" },
    "assembly_id": { "$ref": "common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "common.schema.json#/$defs/id" },
    "frozen_package": { "$ref": "playable-encounter-package.schema.json" },
    "package_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "selected_assets": { "$ref": "#/$defs/assetSelections" },
    "selected_animations": { "$ref": "#/$defs/animationSelections" },
    "assembled_at": { "type": "string", "format": "date-time" },
    "source_evidence": { "$ref": "#/$defs/sourceEvidence" },
    "assembly_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "assetSelections": { "$ref": "#/$defs/selection" },
    "animationSelections": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["animation_id", "revision", "uri", "path", "sha256", "media_type", "byte_length"], "properties": { "animation_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "uri": { "type": "string", "format": "uri" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "media_type": { "const": "model/gltf-binary" }, "byte_length": { "type": "integer", "minimum": 0 } } } },
    "selection": { "type": "array", "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["asset_id", "revision", "uri", "path", "sha256", "media_type", "byte_length"], "properties": { "asset_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "uri": { "type": "string", "format": "uri" }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "media_type": { "const": "model/gltf-binary" }, "byte_length": { "type": "integer", "minimum": 0 } } } },
    "sourceEvidence": { "type": "object", "additionalProperties": false, "required": ["kind", "scope", "observed_at", "build_room_assembly_receipt"], "properties": { "kind": { "const": "local_blender_cli" }, "scope": { "const": "local_blender_cli_only" }, "observed_at": { "type": "string", "format": "date-time" }, "build_room_assembly_receipt": { "$ref": "#/$defs/buildRoomAssemblyReceipt" } } },
    "buildRoomAssemblyReceipt": { "type": "object", "additionalProperties": false, "required": ["schema_version", "receipt_id", "package_id", "package_revision", "package_manifest_sha256", "assembled_at", "selected_modules", "fallback_provenance", "validation", "host_acceptance", "receipt_sha256"], "properties": { "schema_version": { "const": "1" }, "receipt_id": { "$ref": "common.schema.json#/$defs/id" }, "package_id": { "$ref": "common.schema.json#/$defs/id" }, "package_revision": { "type": "integer", "minimum": 1 }, "package_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "assembled_at": { "type": "string", "format": "date-time" }, "selected_modules": { "type": "array", "minItems": 1 }, "fallback_provenance": { "type": "object" }, "validation": { "type": "array" }, "concept_first_lineage": { "type": "object" }, "host_acceptance": { "const": "not_observed" }, "preserved_fallback_history": { "type": "object" }, "receipt_sha256": { "$ref": "common.schema.json#/$defs/sha256" } } }
  }
}
