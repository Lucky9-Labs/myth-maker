{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/encounter-spec.schema.json",
  "title": "EncounterSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "encounter_id", "seed", "deadline_at", "host_capabilities", "objective", "arena_envelope", "desired_roles", "production_gate"],
  "properties": {
    "schema_version": { "const": "2" },
    "encounter_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "seed": { "type": "integer", "minimum": 0 },
    "deadline_at": { "type": "string", "format": "date-time" },
    "host_capabilities": {
      "oneOf": [
        { "$ref": "../v1/host-capability-manifest.schema.json" },
        { "$ref": "host-capability-manifest.schema.json" }
      ]
    },
    "player_context": { "type": "object", "additionalProperties": true },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" },
        "parameters": { "type": "object", "additionalProperties": true }
      }
    },
    "arena_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds", "navigation_profiles"],
      "properties": {
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "depth"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "depth": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "navigation_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" }
        },
        "constraints": { "type": "object", "additionalProperties": true }
      }
    },
    "desired_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" }
    },
    "quality_target": { "type": "integer", "minimum": 0, "maximum": 4, "default": 1 },
    "production_gate": { "$ref": "production-gate.schema.json#/$defs/dispatchGate" }
  }
}
