{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/package-discovery-assembly-receipt.schema.json",
  "title": "PackageDiscoveryAssemblyReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "encounter_id", "package_id", "package_revision", "package_manifest_sha256", "catalog_revision_id", "catalog_revision_sha256", "assembled_at", "acceptance", "selected_modules", "runtime_artifact_manifest", "receipt_sha256"],
  "properties": {
    "schema_version": { "const": "2" }, "receipt_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "encounter_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "package_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "package_revision": { "type": "integer", "minimum": 1 }, "package_manifest_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" }, "catalog_revision_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "catalog_revision_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" }, "assembled_at": { "type": "string", "format": "date-time" }, "acceptance": { "$ref": "package-discovery-catalog-revision.schema.json#/$defs/acceptance" },
    "selected_modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/selectedModule" } }, "runtime_artifact_manifest": { "$ref": "#/$defs/runtimeArtifactManifest" }, "receipt_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "selectedModule": { "type": "object", "additionalProperties": false, "required": ["module_id", "revision", "runtime_artifacts"], "properties": { "module_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "runtime_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "package-discovery-manifest.schema.json#/$defs/artifact" } } } },
    "runtimeArtifactManifest": { "type": "object", "additionalProperties": false, "required": ["schema_version", "profile", "artifact_set_id", "artifacts", "manifest_sha256"], "properties": { "schema_version": { "const": "2" }, "profile": { "const": "runtime-artifact-manifest.v2" }, "artifact_set_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/selectedModule" } }, "manifest_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" } } }
  }
}
