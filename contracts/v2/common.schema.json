{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "tag": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$" },
    "contractName": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}\\.v[1-9][0-9]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "moduleRef": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "revision", "content_sha256"],
      "properties": { "module_id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "content_sha256": { "$ref": "#/$defs/sha256" } }
    },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["uri", "sha256", "media_type"], "properties": { "uri": { "type": "string", "format": "uri", "maxLength": 2048 }, "sha256": { "$ref": "#/$defs/sha256" }, "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }, "byte_length": { "type": "integer", "minimum": 0 } } },
    "compatibility": { "type": "object", "additionalProperties": false, "required": ["host_contract_version"], "properties": { "host_contract_version": { "const": "1" }, "platforms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "scripting_backends": { "type": "array", "uniqueItems": true, "items": { "enum": ["mono", "il2cpp"] } }, "bindings": { "type": "object", "propertyNames": { "$ref": "#/$defs/tag" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 } } } },
    "quality": { "type": "object", "additionalProperties": false, "required": ["tier", "score"], "properties": { "tier": { "type": "integer", "minimum": 0, "maximum": 4 }, "score": { "type": "number", "minimum": 0 }, "evidence": { "type": "array", "items": { "type": "string", "maxLength": 512 } } } }
  }
}
