{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/package-discovery-manifest.schema.json",
  "title": "PackageDiscoveryManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "encounter_id", "request_id", "package_id", "package_revision", "package_manifest_sha256", "assembly_receipt_id", "assembly_receipt_sha256", "catalog_revision_id", "catalog_revision_sha256", "artifacts", "issued_at", "signature"],
  "properties": {
    "schema_version": { "const": "2" },
    "manifest_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "request_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "package_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "package_revision": { "type": "integer", "minimum": 1 },
    "package_manifest_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
    "assembly_receipt_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "assembly_receipt_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
    "catalog_revision_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "catalog_revision_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
    "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact" } },
    "issued_at": { "type": "string", "format": "date-time" },
    "signature": { "$ref": "../v1/package-discovery-manifest.schema.json#/$defs/signature" }
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "revision", "uri", "sha256", "media_type", "byte_length", "compatibility"],
      "properties": {
        "module_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "type": "integer", "minimum": 0 },
        "compatibility": { "$ref": "#/$defs/artifactCompatibility" }
      }
    },
    "artifactCompatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["platforms", "builds", "loaders"],
      "properties": {
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "builds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "loaders": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" } }
      }
    }
  }
}
