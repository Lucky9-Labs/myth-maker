{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/package-discovery-catalog-revision.schema.json",
  "title": "PackageDiscoveryCatalogRevisionV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_revision_id", "encounter_id", "revision", "state", "created_at", "acceptance", "modules", "catalog_sha256"],
  "properties": {
    "schema_version": { "const": "2" },
    "catalog_revision_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "encounter_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "const": "accepted" },
    "created_at": { "type": "string", "format": "date-time" },
    "acceptance": { "$ref": "#/$defs/acceptance" },
    "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } },
    "catalog_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "acceptance": { "type": "object", "additionalProperties": false, "required": ["decision_id", "policy_id", "accepted_at"], "properties": { "decision_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "policy_id": { "$ref": "../v1/common.schema.json#/$defs/contractName" }, "accepted_at": { "type": "string", "format": "date-time" } } },
    "module": { "type": "object", "additionalProperties": false, "required": ["module_id", "revision", "runtime_artifacts", "compatibility"], "properties": { "module_id": { "$ref": "../v1/common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "runtime_artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "package-discovery-manifest.schema.json#/$defs/artifact" } }, "compatibility": { "$ref": "#/$defs/moduleCompatibility" } } },
    "moduleCompatibility": { "type": "object", "additionalProperties": false, "required": ["platforms", "scripting_backends", "execution_kinds", "loaders", "contracts", "limits"], "properties": { "platforms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }, "scripting_backends": { "type": "array", "uniqueItems": true, "items": { "enum": ["mono", "il2cpp"] } }, "execution_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["recipe", "runtime_asset", "managed_plugin", "remote_logic"] } }, "loaders": { "type": "array", "uniqueItems": true, "items": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" } }, "contracts": { "type": "array", "uniqueItems": true, "items": { "$ref": "../v1/common.schema.json#/$defs/contractName" } }, "limits": { "type": "object", "additionalProperties": false, "properties": { "artifact_bytes": { "type": "integer", "minimum": 0 }, "actors": { "type": "integer", "minimum": 1 } } } } }
  }
}
