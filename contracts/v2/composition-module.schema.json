{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/composition-module.schema.json",
  "title": "CompositionModule",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "module_id", "revision", "content_sha256", "execution_kind", "provides", "requires", "conflicts", "compatibility", "quality", "fallback_module_refs", "provenance", "fidelity"],
  "properties": {
    "schema_version": { "const": "2" }, "module_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "execution_kind": { "enum": ["recipe", "runtime_asset", "managed_plugin", "remote_logic"] },
    "provides": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/tag" } },
    "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/contractName" } }, "conflicts": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/tag" } },
    "compatibility": { "$ref": "common.schema.json#/$defs/compatibility" }, "quality": { "$ref": "common.schema.json#/$defs/quality" }, "artifact": { "$ref": "common.schema.json#/$defs/artifact" }, "entrypoint": { "type": "string", "minLength": 1, "maxLength": 256 }, "inline_recipe": { "type": "object", "additionalProperties": true },
    "fallback_module_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/moduleRef" } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["producer", "created_at", "parent_module_refs"], "properties": { "producer": { "type": "string", "minLength": 1, "maxLength": 128 }, "created_at": { "type": "string", "format": "date-time" }, "parent_module_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/moduleRef" } } } },
    "fidelity": { "type": "object", "additionalProperties": false, "required": ["layer_id", "composition_unit", "kind"], "properties": { "layer_id": { "$ref": "common.schema.json#/$defs/id" }, "composition_unit": { "$ref": "common.schema.json#/$defs/id" }, "kind": { "enum": ["whole", "component", "layer"] } } },
    "attachment_seams": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["seam_id", "attachment_kind"], "properties": { "seam_id": { "$ref": "common.schema.json#/$defs/id" }, "attachment_kind": { "$ref": "common.schema.json#/$defs/tag" } } } }
  }
}
