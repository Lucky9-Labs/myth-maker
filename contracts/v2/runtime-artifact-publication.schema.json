{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/runtime-artifact-publication.schema.json",
  "title": "RuntimeArtifactPublicationV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publication_id", "idempotency_key", "runtime_artifact", "host_compatibility", "extension", "artifact_bytes_base64"],
  "properties": {
    "schema_version": { "const": "2" },
    "publication_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$" },
    "runtime_artifact": { "$ref": "#/$defs/runtimeArtifact" },
    "host_compatibility": { "$ref": "#/$defs/hostCompatibility" },
    "extension": { "type": "string", "pattern": "^[a-z0-9]{1,16}$" },
    "artifact_bytes_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" }
  },
  "$defs": {
    "runtimeArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["module_id", "revision", "source_artifact_uri", "sha256", "media_type", "byte_length", "compatibility"],
      "properties": {
        "module_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "source_artifact_uri": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "byte_length": { "type": "integer", "minimum": 0 },
        "compatibility": { "$ref": "package-discovery-manifest.schema.json#/$defs/artifactCompatibility" }
      }
    },
    "hostCompatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "engine_build", "scripting_backend", "loader"],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "engine_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scripting_backend": { "enum": ["mono", "il2cpp"] },
        "loader": { "$ref": "../v1/common.schema.json#/$defs/semanticTag" }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "publication_id", "artifact", "source_artifact_uri", "host_compatibility", "publication_request_sha256", "published_at", "publication_sha256"],
      "properties": {
        "schema_version": { "const": "2" },
        "publication_id": { "$ref": "../v1/common.schema.json#/$defs/id" },
        "artifact": { "$ref": "package-discovery-manifest.schema.json#/$defs/artifact" },
        "source_artifact_uri": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "host_compatibility": { "$ref": "#/$defs/hostCompatibility" },
        "publication_request_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" },
        "published_at": { "type": "string", "format": "date-time" },
        "publication_sha256": { "$ref": "../v1/common.schema.json#/$defs/sha256" }
      }
    }
  }
}
