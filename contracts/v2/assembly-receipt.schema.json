{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myth-maker.dev/contracts/v2/assembly-receipt.schema.json",
  "title": "AssemblyReceipt",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "revision", "assembled_at", "selected_modules", "rejected_conflicts", "validation_evidence", "fallback_provenance", "source_package_revision", "source_package_sha256", "geometric_stitching", "receipt_sha256"],
  "properties": { "schema_version": { "const": "2" }, "receipt_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "assembled_at": { "type": "string", "format": "date-time" }, "selected_modules": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["module_id", "revision", "content_sha256", "quality_score", "selection_reason"], "properties": { "module_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "content_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "quality_score": { "type": "number", "minimum": 0 }, "selection_reason": { "type": "string", "minLength": 1, "maxLength": 256 } } } }, "rejected_conflicts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["module_id", "revision", "reasons"], "properties": { "module_id": { "$ref": "common.schema.json#/$defs/id" }, "revision": { "type": "integer", "minimum": 0 }, "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 512 } } } } }, "validation_evidence": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 512 } }, "fallback_provenance": { "type": "object", "additionalProperties": false, "required": ["used_fallback", "module_ids"], "properties": { "used_fallback": { "type": "boolean" }, "module_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } } } }, "source_package_revision": { "type": "integer", "minimum": 1 }, "source_package_sha256": { "$ref": "common.schema.json#/$defs/sha256" }, "geometric_stitching": { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "const": "unimplemented" }, "reason": { "type": "string", "minLength": 1, "maxLength": 512 } } }, "receipt_sha256": { "$ref": "common.schema.json#/$defs/sha256" } }
}
