{
  "name": "myth-maker-encounter-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build-room": "node --watch --watch-preserve-output src/build-room-server.js",
    "example:assembler": "node examples/assemble-encounter-package.mjs",
    "example:catalog": "node examples/catalog-v0.mjs",
    "catalog:import": "node src/catalog-seeder-cli.js",
    "example:workgraph": "node examples/run-workgraph.mjs",
    "test": "node --test tests/*.mjs && python3 -m unittest tests/test_*.py",
    "test:cloudflare": "node --test tests/test_cloudflare_worker.mjs",
    "test:contracts": "node --test tests/test_contracts.mjs",
    "test:infrastructure": "python3 -m unittest tests/test_infrastructure_contract.py"
  }
}
