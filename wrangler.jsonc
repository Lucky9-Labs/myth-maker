{
  "name": "myth-maker-encounter-runtime",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["AGENT_INGRESS_TOKEN", "PACKAGE_DISCOVERY_SIGNING_PRIVATE_KEY", "CATALOG_ACCEPTANCE_TOKEN", "WORK_DISPATCH_TOKEN"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ENCOUNTER_COORDINATOR",
        "class_name": "EncounterCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EncounterCoordinator"]
    }
  ]
}
